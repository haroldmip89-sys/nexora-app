# Names only. Copy to .env.local and fill in the values (never commit real values).
# Deployed (Vercel): variables are stored in the Vercel project panel (Settings > Environment Variables), not in files. See docs/DEPLOYMENT.md section 2.
# Variables marked [SECRET] must never be exposed to the client or committed.

# Database (Neon)
# [SECRET]
DATABASE_URL=

# Clerk (demo runs on *.vercel.app with Clerk Development: pk_test_ / sk_test_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# [SECRET]
CLERK_SECRET_KEY=
# Optional locally (needs a tunnel); required in deployed environments
# [SECRET]
CLERK_WEBHOOK_SIGNING_SECRET=

# Clerk routes (fixed values: /sign-in, /sign-up, /onboarding, /)
# Value: /sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
# Value: /sign-up
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
# Value: /onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=
# Value: /
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=

# Stripe (Test Mode only: sk_test_..., never a live key)
# [SECRET]
STRIPE_SECRET_KEY=
# Public origin of this app, used for Stripe success/cancel URLs.
# Local: http://localhost:3000. Production: https origin only, no trailing slash, no path, not localhost (e.g. https://your-app.vercel.app)
APP_URL=
# Stripe webhook signing secret (whsec_...)
# Local: the one printed by `stripe listen`.
# Deployed: the signing secret of the Test Mode endpoint created in the Stripe Dashboard (NOT the `stripe listen` one)
# [SECRET]
STRIPE_WEBHOOK_SECRET=
